VITE_API_BASE_URL=http://localhost:8080/api

# Both optional - the app runs fine without them, just falls back to
# calling Nominatim/no-routing directly (see AddressMapPicker.jsx /
# RouteMap.jsx for the exact fallback behavior). Set these to fix the
# "map doesn't work well" symptoms caused by OSRM's public demo routing
# server and Nominatim's 1-req/sec browser usage policy.
# Free, no card: https://openrouteservice.org/dev/#/signup
VITE_ORS_API_KEY=
# Free, no card: https://locationiq.com/register
VITE_LOCATIONIQ_API_KEY=
